<Window x:Class="task4WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Квадратне рівняння" Height="380" Width="380">
    <StackPanel Margin="15">
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="30"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="30"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="30"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="40"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="txtA" Grid.Column="0" Height="25"/>
            <TextBlock Text="x² +" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            <TextBox x:Name="txtB" Grid.Column="2" Height="25"/>
            <TextBlock Text="x +" Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            <TextBox x:Name="txtC" Grid.Column="4" Height="25"/>
            <TextBlock Text="= 0" Grid.Column="5" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Grid>

        <Button x:Name="btnSolve" Content="Розв'язати" Height="30" Margin="0,10" Click="btnSolve_Click"/>

        <TextBlock x:Name="lblD" FontSize="14" FontWeight="Bold" Margin="0,5" Visibility="Collapsed"/>
        <TextBlock x:Name="lblMessage" Foreground="Red" FontSize="14" Margin="0,5" Visibility="Collapsed"/>

        <StackPanel x:Name="panelX1" Orientation="Horizontal" Margin="0,5" Visibility="Collapsed">
            <TextBlock x:Name="lblX1Name" Text="x1 = " FontSize="14"/>
            <TextBox x:Name="txtX1" Width="100" IsReadOnly="True"/>
        </StackPanel>

        <StackPanel x:Name="panelX2" Orientation="Horizontal" Margin="0,5" Visibility="Collapsed">
            <TextBlock Text="x2 = " FontSize="14"/>
            <TextBox x:Name="txtX2" Width="100" IsReadOnly="True"/>
        </StackPanel>
    </StackPanel>
</Window>