<Window x:Class="OOP2SWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MainWindow" Height="300" Width="350">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Label Content="Значення x" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
        <TextBox x:Name="txtX" Grid.Row="0" Grid.Column="1" Height="26" Margin="5"/>

        <Label Content="Значення y" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
        <TextBox x:Name="txtY" Grid.Row="1" Grid.Column="1" Height="26" Margin="5"/>

        <Label Content="Значення z" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"/>
        <TextBox x:Name="txtZ" Grid.Row="2" Grid.Column="1" Height="26" Margin="5"/>

        <Button x:Name="btnCalculate" Content="Обчислити" Grid.Row="3" Grid.ColumnSpan="2" 
                Width="100" Height="30" Margin="10" Click="btnCalculate_Click"/>

        <TextBlock x:Name="txtResult" Grid.Row="4" Grid.ColumnSpan="2" 
                   FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/>
    </Grid>
</Window>